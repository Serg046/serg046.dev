        </div>
    </div>

    <section class="rating-section">
        @if (_rankingError is not null)
        {
            <p class="error">@_rankingError</p>
        }
        else if (LocationRankings is null)
        {
            <p>Loading rating...</p>
        }
        else if (LocationRankings.Count > 0)
        {
            <div class="rating-list">
                @foreach (var ranking in LocationRankings)
                {
                    <div class="rating-card">
                        <span class="rating-location">@ranking.Location</span>
                        <span class="rating-rank">#@ranking.Rank.ToString("N0")</span>
                        <span class="rating-detail">
                            of @ranking.Total.ToString("N0") by followers (top @GetPercentile(ranking).ToString("0.0")%)
                        </span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="featured-section">
        <h2 class="section-title">My repositories</h2>
        @if (_featuredError is not null)
        {
            <p class="error">@_featuredError</p>
        }
        else if (FeaturedRepos is null)
        {
            <p>Loading featured repos...</p>
        }
        else if (FeaturedRepos.Count > 0)
        {
            <div class="featured-list">
                @foreach (var repo in FeaturedRepos)
                {
                    <a class="featured-card" href="@repo.Url" target="_blank" rel="noopener">
                        <div class="featured-header">
                            <span class="featured-name">@repo.Name</span>
                            <span class="featured-stars">★ @repo.Stars</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(repo.Description))
                        {
                            <p class="featured-description">@repo.Description</p>
                        }
                    </a>
                }
            </div>
        }
    </section>

    <section class="main-section">
        <h2 class="section-title">Community repositories</h2>
        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
        else if (_repoGroups is null)
        {
            <p>Loading pull requests from GitHub...</p>
        }
        else if (_repoGroups.Count == 0)
        {
            <p>No pull requests found.</p>
        }
        else
        {
            <div class="pr-browser">
                <ul class="repo-pane" @ref="_repoPaneRef">
                    @foreach (var group in _repoGroups)
                    {
                        <li data-repo-item="@group.Repo">
                            <button type="button"
                                    class="repo-item @(group.Repo == _selectedRepo ? "selected" : "")"
                                    @onclick="() => ScrollToRepoAsync(group.Repo)">
                                <span class="repo-name">@group.Repo</span>
                                <span class="repo-stars">★ @group.Stars</span>
                            </button>
                        </li>
                    }
                </ul>

                <div class="pr-pane" @ref="_prPaneRef">
                    @foreach (var group in _repoGroups)
                    {
                        <div class="pr-group" data-repo-section="@group.Repo">
                            <a class="pr-pane-header" href="@group.RepoUrl" target="_blank" rel="noopener">@group.Repo</a>
                            @foreach (var pr in group.PullRequests)
                            {
                                <a class="pr-card" href="@pr.Url" target="_blank" rel="noopener">
                                    <div class="pr-header">
                                        <p class="pr-title">@pr.Title</p>
                                        <span class="pr-state pr-state-@pr.State.ToLowerInvariant()">@pr.State</span>
                                    </div>
                                    <span class="pr-date">@pr.CreatedAt.ToString("MMM d, yyyy")</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </section>
</div>

@code {
    [PersistentState]
    public List<PullRequest>? PullRequests { get; set; }

    [PersistentState]
    public List<Organization>? Organizations { get; set; }

    [PersistentState]
    public List<FeaturedRepo>? FeaturedRepos { get; set; }

    [PersistentState]
    public List<LocationRanking>? LocationRankings { get; set; }

    private string? _error;
    private string? _orgsError;
    private string? _featuredError;
    private string? _rankingError;
    private List<RepoGroup>? _repoGroups;
    private string? _selectedRepo;
    private ElementReference _prPaneRef;
    private ElementReference _repoPaneRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _scrollSpy;
    private DotNetObjectReference<Home>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadPullRequestsAsync(), LoadOrganizationsAsync(), LoadFeaturedReposAsync(), LoadLocationRankingsAsync());

        _repoGroups = PullRequests?
            .GroupBy(pr => pr.Repo)
            .Select(g => new RepoGroup(g.Key, g.First().RepoUrl, g.Max(pr => pr.Stars), g.ToList()))
            .ToList() ?? [];
        _selectedRepo = _repoGroups.FirstOrDefault()?.Repo;
    }

    private async Task LoadPullRequestsAsync()
    {
        if (PullRequests is not null)
        {
            return;
        }

        try
        {
            PullRequests = await Http.GetFromJsonAsync<List<PullRequest>>(
                "api/prs", new JsonSerializerOptions(JsonSerializerDefaults.Web));
        }
        catch (Exception ex)
        {
            _error = $"Failed to load pull requests from GitHub: {ex.Message}";
        }
    }

    private async Task LoadOrganizationsAsync()
    {
        if (Organizations is not null)
        {
            return;
        }

        try
        {
            Organizations = await Http.GetFromJsonAsync<List<Organization>>(
                "api/orgs", new JsonSerializerOptions(JsonSerializerDefaults.Web));
        }
        catch (Exception ex)
        {
            _orgsError = $"Failed to load organizations from GitHub: {ex.Message}";
        }
    }

    private async Task LoadFeaturedReposAsync()
    {
        if (FeaturedRepos is not null)
        {
            return;
        }

        try
        {
            FeaturedRepos = await Http.GetFromJsonAsync<List<FeaturedRepo>>(
                "api/featured-repos", new JsonSerializerOptions(JsonSerializerDefaults.Web));
        }
        catch (Exception ex)
        {
            _featuredError = $"Failed to load featured repos from GitHub: {ex.Message}";
        }
    }

    private async Task LoadLocationRankingsAsync()
    {
        if (LocationRankings is not null)
        {
            return;
        }

        try
        {
            LocationRankings = await Http.GetFromJsonAsync<List<LocationRanking>>(
                "api/location-rankings", new JsonSerializerOptions(JsonSerializerDefaults.Web));
        }
        catch (Exception ex)
        {
            _rankingError = $"Failed to load rating from GitHub: {ex.Message}";
        }
    }

    private static double GetPercentile(LocationRanking ranking) =>
        ranking.Total == 0 ? 0 : (double)ranking.Rank / ranking.Total * 100;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive && _repoGroups is { Count: > 0 })
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Home.razor.js");
            _selfRef = DotNetObjectReference.Create(this);
            _scrollSpy = await _module.InvokeAsync<IJSObjectReference>("initScrollSpy", _prPaneRef, _selfRef);
        }
    }

    private async Task ScrollToRepoAsync(string repo)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("scrollToSection", _prPaneRef, repo);
        }
    }

    [JSInvokable]
    public async Task OnSectionActivated(string repo)
    {
        if (_selectedRepo != repo)
        {
            _selectedRepo = repo;
            StateHasChanged();

            if (_module is not null)
            {
                await _module.InvokeVoidAsync("scrollRepoItemIntoView", _repoPaneRef, repo);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollSpy is not null)
        {
            await _scrollSpy.InvokeVoidAsync("dispose");
            await _scrollSpy.DisposeAsync();
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }

        _selfRef?.Dispose();
    }

    private record RepoGroup(string Repo, string RepoUrl, int Stars, List<PullRequest> PullRequests);
}
