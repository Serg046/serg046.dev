@page "/"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Sergey Aseev</PageTitle>

<div class="page-content">
    <div class="hero">
        <img class="avatar" src="/img/avatar.jpg" alt="Sergey Aseev"/>
        <div class="hero-info">
            <h1>Sergey Aseev</h1>

            <section class="orgs-section">
                @if (_orgsError is not null)
                {
                    <p class="error">@_orgsError</p>
                }
                else if (Organizations is null)
                {
                    <p>Loading organizations...</p>
                }
                else if (Organizations.Count > 0)
                {
                    <div class="org-list">
                        @foreach (var org in Organizations)
                        {
                            <a class="org-card" href="@org.Url" target="_blank" rel="noopener">
                                <img class="org-logo" src="@org.AvatarUrl" alt="@org.Name"/>
                                <p class="org-name">@org.Name</p>
                            </a>
                        }
                    </div>
                }
            </section>

